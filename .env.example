# Copy to .env.local and fill in. Never commit .env.local.

# Database (Supabase PostgreSQL). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET= # generate with: npx auth secret
OWNER_EMAIL= # owner login email (e.g. owner@akshelf.local)
OWNER_PASSWORD= # owner login password

# Metadata providers (server-side only; never prefix with NEXT_PUBLIC_)
TMDB_API_KEY=
