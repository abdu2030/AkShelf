# ==============================================================================
# AkShelf Environment Configuration Template
# Copy this file to .env.local and fill in your values. Never commit .env.local.
# Security Note: Never prefix sensitive secrets with NEXT_PUBLIC_ (server-only).
# ==============================================================================

# Database (Supabase PostgreSQL)
# Pooled URL (transaction pooler on port 6543) for Next.js application queries
DATABASE_URL=
# Direct URL (session pooler on port 5432) for Prisma CLI migrations & schema push
DIRECT_URL=

# Authentication (Auth.js v5 / NextAuth)
AUTH_SECRET= # generate with: npx auth secret
OWNER_EMAIL= # owner login email (e.g. owner@akshelf.local)
OWNER_PASSWORD_HASH= # bcrypt hash of owner password (escape \$ signs as "\$2b\$10\$..." to avoid Next.js env expansion)

# Metadata Providers (Server-side only)
TMDB_API_KEY= # TMDB v3 API Key (optional if read access token provided)
TMDB_API_READ_ACCESS_TOKEN= # TMDB v4 Bearer Read Access Token (preferred)
