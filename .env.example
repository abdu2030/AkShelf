# ==============================================================================
# AkShelf Environment Configuration Template (v1.0.0-rc.1)
# Copy this file to .env.local for local development, or add these keys to the
# Environment Variables section in your Vercel Project Settings for production.
# Security Note: Never prefix sensitive secrets with NEXT_PUBLIC_ (server-only).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL with Connection Pooling)
# ------------------------------------------------------------------------------
# Pooled URL: Use Supabase Transaction Pooler (port 6543) for runtime queries.
# Append ?pgbouncer=true&connection_limit=1 to prevent connection exhaustion in serverless.
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Direct URL: Use Supabase Direct / Session Connection (port 5432) for Prisma CLI migrations.
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js v5 / NextAuth Single-Owner)
# ------------------------------------------------------------------------------
# Random 32+ byte secret string used to sign JWT session cookies.
# Generate with: openssl rand -base64 32  or  npx auth secret
AUTH_SECRET=

# Public Canonical URL of your deployment (Vercel sets this automatically in preview/prod)
# Example: https://akshelf.vercel.app or http://localhost:3000
NEXTAUTH_URL=

# Owner Account Credentials (Private single-user login)
OWNER_EMAIL=owner@akshelf.local

# Bcrypt hash of the owner password (cost factor 10+).
# IMPORTANT: If placing in .env.local on Windows/Unix, escape $ signs as "\$2b\$10\$..."
# to prevent shell/Next.js variable expansion.
OWNER_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# 3. Metadata Providers (Server-side external catalog integration)
# ------------------------------------------------------------------------------
# The Movie Database (TMDB) credentials for Movies & TV series
# Get these from: https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Note: AniList GraphQL requires no API key (public rate-limited endpoint).
